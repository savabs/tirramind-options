# Paddle. Nothing here is a secret; fill it in locally and never commit the result.
TMO_PADDLE_MODE=sandbox                 # sandbox | live
TMO_PADDLE_API_KEY=
TMO_PADDLE_CLIENT_TOKEN=
TMO_PADDLE_WEBHOOK_SECRET=              # required in live; without it, signatures are not checked
TMO_PADDLE_PRICE_ID=

# Which price sells which tier. Required in live. A price that is not listed
# here provisions nothing, deliberately: see src/tmo/payments/tiers.py.
TMO_TIER_PRICE_MAP=pri_xxx:terminal

# How long a failed card keeps working while Paddle retries. Default 3 days.
TMO_PAST_DUE_GRACE_S=
