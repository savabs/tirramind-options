{
  "note": "One table of cases, two implementations. web/lib/rules.ts and src/tmo/payments/store.py must both satisfy every case here. The rules decide who may use a paid product, so a disagreement between the two is a disagreement about money, and the only way that stays honest is for both test suites to read this file.",
  "effective_active": [
    {"case": "a plain active flag, nothing else set",
     "entry": {"active": true}, "now": 1000, "expect": true},
    {"case": "a plain inactive flag",
     "entry": {"active": false}, "now": 1000, "expect": false},
    {"case": "no record at all",
     "entry": null, "now": 1000, "expect": false},
    {"case": "cancelled but paid through the end of the period",
     "entry": {"active": false, "active_until": 2000}, "now": 1000, "expect": true},
    {"case": "the paid period has now passed",
     "entry": {"active": false, "active_until": 2000}, "now": 2000, "expect": false},
    {"case": "a hard expiry beats a grace window still on file",
     "entry": {"active": true, "active_until": 9000, "expires_at": 1000}, "now": 1000, "expect": false},
    {"case": "a hard expiry in the future does not revoke on its own",
     "entry": {"active": true, "active_until": 9000, "expires_at": 5000}, "now": 1000, "expect": true},
    {"case": "expires_at exactly now revokes: the ceiling is inclusive",
     "entry": {"active": true, "expires_at": 1000}, "now": 1000, "expect": false},
    {"case": "active_until exactly now does not grant: the window is exclusive",
     "entry": {"active": false, "active_until": 1000}, "now": 1000, "expect": false},
    {"case": "a failed card inside its grace window",
     "entry": {"active": false, "active_until": 1500}, "now": 1000, "expect": true}
  ],
  "tier": [
    {"case": "a mapped price sells its tier",
     "map": "pri_a:terminal,pri_b:annual", "price_id": "pri_a", "expect": "terminal"},
    {"case": "the second mapped price",
     "map": "pri_a:terminal,pri_b:annual", "price_id": "pri_b", "expect": "annual"},
    {"case": "a price we do not sell provisions nothing",
     "map": "pri_a:terminal", "price_id": "pri_zzz", "expect": null},
    {"case": "no price at all",
     "map": "pri_a:terminal", "price_id": null, "expect": null},
    {"case": "no map configured means nothing is sold",
     "map": "", "price_id": "pri_a", "expect": null},
    {"case": "whitespace around entries is tolerated",
     "map": " pri_a : terminal , pri_b:annual ", "price_id": "pri_a", "expect": "terminal"},
    {"case": "a malformed entry is skipped, not guessed at",
     "map": "garbage,pri_a:terminal", "price_id": "pri_a", "expect": "terminal"},
    {"case": "an entry with no tier is not a sale",
     "map": "pri_a:", "price_id": "pri_a", "expect": null}
  ],
  "adjustment": [
    {"case": "a settled full refund revokes",
     "action": "refund", "status": "approved", "kind": "full", "expect_revoke": true, "expect_applied": true},
    {"case": "a settled partial refund does not revoke",
     "action": "refund", "status": "approved", "kind": "partial", "expect_revoke": false, "expect_applied": true},
    {"case": "a chargeback revokes whatever its size",
     "action": "chargeback", "status": "approved", "kind": "partial", "expect_revoke": true, "expect_applied": true},
    {"case": "a refund awaiting approval changes nothing",
     "action": "refund", "status": "pending_approval", "kind": "full", "expect_revoke": false, "expect_applied": false},
    {"case": "a rejected refund changes nothing",
     "action": "refund", "status": "rejected", "kind": "full", "expect_revoke": false, "expect_applied": false},
    {"case": "a chargeback warning is not a chargeback",
     "action": "chargeback_warning", "status": "approved", "kind": "full", "expect_revoke": false, "expect_applied": false},
    {"case": "a credit does not touch access",
     "action": "credit", "status": "approved", "kind": "full", "expect_revoke": false, "expect_applied": false},
    {"case": "a reversed chargeback is not a revocation",
     "action": "chargeback_reverse", "status": "approved", "kind": "full", "expect_revoke": false, "expect_applied": false}
  ]
}
